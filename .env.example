# TypeSafe (required for live guardrail checks)
TYPESAFE_API_KEY=

# Optional model override (Blackrose default: jev-latest)
TYPESAFE_MODEL=jev-latest

# Decision-model provider: typesafe (default) or openai (experimental; needs a transport in code)
BLACKROSE_PROVIDER=typesafe

# Optional model name passed to your OpenAI Decisions transport
OPENAI_DECISIONS_MODEL=
